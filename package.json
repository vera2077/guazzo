{
  "name": "guazzo",
  "private": true,
  "license": "Apache-2.0",
  "version": "1.3.1",
  "type": "module",
  "description": "Guazzo — a fully offline Photoshop-shaped image editor",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node node_modules/typescript/bin/tsc",
    "check": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node scripts/ci.mjs",
    "single": "node scripts/single-file.mjs",
    "smoke": "node scripts/ui-smoke.mjs",
    "notices": "node scripts/embed-notices.mjs",
    "vendor:psd": "node scripts/vendor-psd.mjs",
    "desktop": "node scripts/build-desktop.mjs",
    "bump": "node scripts/bump.mjs",
    "desktop:full": "node scripts/build-desktop.mjs && cd src-tauri && CARGO_HOME=../.cargo-home cargo build --release",
    "pins": "node scripts/pins.mjs",
    "ci": "node scripts/ci.mjs",
    "bench": "node scripts/bench.mjs",
    "release": "node scripts/release.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "ag-psd": "^34.2.1"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.28.5"
}
